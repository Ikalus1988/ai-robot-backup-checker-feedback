# 部署用真实配置模板 —— 复制成 wrangler.local.toml 后填入真实值
#
#   cp wrangler.toml.example wrangler.local.toml
#   # 填入 account_id / database_id
#   npx wrangler deploy --config wrangler.local.toml
#
# wrangler.local.toml 不入仓（见 .gitignore）。
# 本模板里出现的 ID 是占位符，不是真实资源标识。

name = "rbc-telemetry"
main = "src/index.ts"
compatibility_date = "2026-10-01"
# 曾启用 compatibility_flags = ["nodejs_compat"]，现已移除（本 Worker 零依赖、零 Node API）。

# CF 账号 ID（Dashboard → Workers & Pages → 右侧 Account ID）
account_id = "REPLACE_WITH_YOUR_CF_ACCOUNT_ID"

routes = [
  { pattern = "telemetry.misakanet.org", custom_domain = true }
]

[limits]
# 原值 50_000 高于付费档默认的 30 秒，与「压低跑飞账单」的意图相反；现取 10 秒。
cpu_ms = 10_000

[triggers]
crons = ["23 4 * * *"]

[[d1_databases]]
binding = "DB"
database_name = "telemetry-db"
# wrangler d1 create telemetry-db 的输出
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

[vars]
WEBSITE_ID = "robot-backup-checker"
GATE_REQ_DAY = "100000"
GATE_EVT_DAY = "100000"
# 存储闸门阈值：清理后仍超期未清的行数。取代旧的 GATE_STORE_MAX_MB（那是从未生效的死旋钮）。
GATE_RETENTION_BACKLOG_ROWS = "1000"
# 单 isolate 令牌桶限流（per-isolate，非全局精确）
RATE_LIMIT_PER_MIN = "120"

# 单设备限流：同一 device_id 每小时最多放行多少个上报请求（超了返 429 + Retry-After）。
# ⚠️ 口径：**per-isolate 内存计数**（不写 D1），不是跨 isolate 全局精确；
#    跨 isolate 并行的兜底是每日闸门（D1，跨 isolate 精确）。
DEVICE_LIMIT_PER_HOUR = "60"
RETENTION_DAYS = "90"

[observability]
enabled = true

# DASHBOARD_TOKEN 走 secret：wrangler secret put DASHBOARD_TOKEN
# INGEST_KEY 走 secret：wrangler secret put INGEST_KEY
#   上报端必须带 X-Ingest-Key 头；未配置时服务端 fail closed（返 500，不放行）。

# 版本维度口径：raw=按事件自带版本分桶（现状，默认）| by_device_max=每设备归到其最新版本
VERSION_DIMENSION_MODE = "raw"
