{
  "name": "rbc-telemetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "机器人程序检查&转换工具 · 匿名使用统计接收端（CF Worker + D1）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute telemetry-db --local --file schema.sql",
    "db:init:remote": "wrangler d1 execute telemetry-db --remote --file schema.sql",
    "db:query:local": "wrangler d1 execute telemetry-db --local --command",
    "db:query:remote": "wrangler d1 execute telemetry-db --remote --command",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "typescript": "^5.8.0",
    "wrangler": "4.112.0"
  }
}
